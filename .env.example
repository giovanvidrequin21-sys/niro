# Utilisation : node --env-file=.env server.js
PORT=3000
# 127.0.0.1 si le serveur est derrière un proxy HTTPS (recommandé) ; 0.0.0.0 sinon
HOST=127.0.0.1
# Dossier des comptes et sessions : à placer sur un disque PERSISTANT et à sauvegarder
DATA_DIR=./data
# invite (code d'invitation requis, recommandé) | open (inscription libre) | closed (aucune inscription)
REGISTRATION=invite
# Derrière un proxy HTTPS (Caddy, nginx…) : 1. Le serveur ne doit alors être joignable que par ce proxy.
TRUST_PROXY=0
# auto : cookie « Secure » dès que la connexion est en HTTPS ; 1 : toujours ; 0 : jamais
COOKIE_SECURE=auto
# HTTPS direct sans proxy (facultatif)
# TLS_CERT=/chemin/fullchain.pem
# TLS_KEY=/chemin/privkey.pem
# Durées de session en secondes (inactivité : 12 h ; durée maximale : 7 jours)
SESSION_IDLE_SECONDS=43200
SESSION_MAX_SECONDS=604800
MAX_SESSIONS_PER_USER=10
# Limitation : échecs par adresse IP et par 10 minutes ; échecs avant verrouillage d'un compte
IP_AUTH_LIMIT=30
LOCK_AFTER_FAILURES=5
REG_PER_IP_PER_HOUR=10
